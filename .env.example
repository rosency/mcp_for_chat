ANTHROPIC_API_KEY=your-api-key

# Model: "claude-3-5-haiku-20241022" (default, cost-effective) or "claude-sonnet-4-20250514" (more capable)
MODEL=claude-3-5-haiku-20241022

# Search provider: "duckduckgo" (default, no API key needed) or "brave"
SEARCH_PROVIDER=duckduckgo

# Only needed if SEARCH_PROVIDER=brave
BRAVE_API_KEY=your-brave-api-key

LOG_LEVEL=INFO
SESSION_TIMEOUT=3600
